# Copy this file to ".env" and fill in your values. NEVER share or commit .env.

# --- Local LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Email alerts (Gmail: turn on 2-Step Verification, then create an "App password") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_address@gmail.com
SMTP_PASS=your_16_char_app_password
ALERT_TO=varsha.suresh.mys@gmail.com
EMAIL_DAILY_REPORT=true

# --- Live syslog listener (UDP). 514 is the standard port, 5514 needs no special rights ---
SYSLOG_PORT=5514

# --- Daily report time (24h, local time) ---
REPORT_TIME=23:59

# --- Detection thresholds ---
BRUTE_THRESHOLD=10
BRUTE_WINDOW_SEC=60
PORTSCAN_PORTS=15
ODD_HOUR_START=0
ODD_HOUR_END=5
EXFIL_MB=100
